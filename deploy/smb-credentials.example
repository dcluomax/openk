# 共享存储（SMB）凭据，供 ensure-mount.sh 使用。
#
# 复制到 ~/.openk-smb 并且务必收紧权限：
#     cp deploy/smb-credentials.example ~/.openk-smb
#     chmod 600 ~/.openk-smb
#
# 这里是明文密码。之所以不用钥匙串，是因为 `security find-internet-password -w`
# 会弹窗要求授权，开机无人值守时会把启动流程卡死。
# 建议为这个用途单开一个权限最小的账号，而不是复用管理员账号。
SMB_HOST=192.168.0.10
SMB_SHARE=Media
SMB_USER=openk
SMB_PASS=change-me
