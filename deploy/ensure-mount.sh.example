#!/bin/sh
# 启动 worker 前，等共享存储就绪。
#
# 这里只「等待」不「挂载」，是刻意的：挂载已经由系统里既有的登录项完成
# （它用钥匙串凭据，不需要在磁盘上另存一份密码）。本脚本要解决的是时序问题——
# 开机后 worker 可能比挂载先起来，对着还不存在的路径反复报错。
#
# 两条走过弯路、别再踩的经验：
#  1. 不要另起一个 mount_smbfs 挂到别处：macOS 不允许同一共享挂两次，
#     后挂的会一直 "File exists"，而且两份挂载点也会让路径映射产生歧义。
#  2. 挂载点绝对不要放在 $HOME 里面。家目录会被各种 CLI / 编辑器 / 索引器
#     递归扫描，一旦扫进一个几十 TB 的网络共享，就会永久卡在 opendir 上——
#     现象是进程 0% CPU、没有任何网络连接，极难定位。
MOUNT_POINT="${OPENK_SMB_MOUNT:-/Volumes/Media}"
PROBE="${OPENK_SMB_PROBE:-$MOUNT_POINT/openk/data}"
WAIT_SECONDS="${OPENK_SMB_WAIT:-120}"

waited=0
while [ "$waited" -lt "$WAIT_SECONDS" ]; do
    if [ -d "$PROBE" ]; then
        [ "$waited" -gt 0 ] && echo "[mount] $PROBE 就绪（等了 ${waited}s）"
        exit 0
    fi
    sleep 5
    waited=$((waited + 5))
done

echo "[mount] 等待 ${WAIT_SECONDS}s 后 $PROBE 仍不可用，本轮不启动 worker"
echo "[mount] 检查登录项是否挂上了 $MOUNT_POINT：mount | grep $MOUNT_POINT"
exit 1
