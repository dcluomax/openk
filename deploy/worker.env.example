# openk worker（跑 ML 的那台机器）环境变量示例
#
#   cp deploy/worker.env.example worker.env
#
# worker 只负责算，不存长期数据；它通过共享存储（NFS / SMB）读写任务目录。

# 服务端地址。worker 与服务端之间走内网明文 HTTP 即可——
# 就算浏览器那侧上了 HTTPS（反向代理终结 TLS），这里也不用改。
OPENK_SERVER=http://192.0.2.10:8000

# 与服务端一致的口令。两边不一样会一直 401。
OPENK_WORKER_TOKEN=换成你自己的随机口令

# 日志和状态页里的标识，留空则用主机名。
#OPENK_WORKER_ID=gpu-box

# 本机愿意接的任务类型。算力有限时可以只接一部分，
# 比如只接分离：OPENK_WORKER_KINDS=separate
#OPENK_WORKER_KINDS=separate,transcribe,align

# 共享存储的路径映射：服务端看到的路径=本机看到的路径，多组用逗号分隔。
# 两台机器挂载点不同名时必须配，否则 worker 会报文件不存在。
OPENK_WORKER_PATH_MAP=/data=/mnt/openk-data

# 共享存储是 SMB 且由登录项挂载时，填上这个地址，ensure-mount.sh 就能在
# 登录项没挂上（重启后偶发，且不报错）时兜底挂一次。不要写密码——
# 先手工挂一次让系统把凭据存进钥匙串，这里免密复用即可。
#OPENK_SMB_URL=smb://用户名@192.0.2.10/Media
# 挂载点、探针路径、总等待时长、让给登录项的宽限秒数，一般不用改。
#OPENK_SMB_MOUNT=/Volumes/Media
#OPENK_SMB_PROBE=/Volumes/Media/openk/data
#OPENK_SMB_WAIT=120
#OPENK_SMB_GRACE=20

# 先把输入拷到本机临时盘再算。网络存储上强烈建议保持开启，
# 分离过程是大量随机读写，直接在 NFS/SMB 上做会慢很多。
#OPENK_WORKER_STAGE_LOCAL=true

# 模型缓存。audio-separator 默认放 /tmp，重启可能被清空；
# 模型有好几 GB，指到持久盘上省得反复下载。
#OPENK_MODELS_DIR=/var/lib/openk/models

# Apple Silicon / 无 NVIDIA 显卡用 cpu + int8；有 CUDA 则 cuda + float16。
#OPENK_WHISPER_DEVICE=cpu
#OPENK_WHISPER_COMPUTE_TYPE=int8
