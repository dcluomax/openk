#!/bin/bash
# 分布式部署示例：先配置宿主机目录与 UID/GID，再运行；不要在脚本内填写口令。
# 数据目录必须持久化，媒体目录只读，归档目录单独可写。
# 升级前停止提交新任务，并确认服务端与 worker 使用相同版本。
set -euo pipefail

NAME="${OPENK_CONTAINER_NAME:-openk}"
NET="${OPENK_NETWORK:-openk-net}"
IMAGE="${OPENK_IMAGE:-ghcr.io/dcluomax/openk:stable}"
DATA="${OPENK_HOST_DATA_DIR:?请设置宿主机数据目录 OPENK_HOST_DATA_DIR}"
MEDIA="${OPENK_HOST_MEDIA_DIR:?请设置宿主机媒体目录 OPENK_HOST_MEDIA_DIR}"
LIB="${OPENK_HOST_LIBRARY_DIR:?请设置宿主机归档目录 OPENK_HOST_LIBRARY_DIR}"
RUN_UID="${OPENK_RUN_UID:-$(id -u)}"
RUN_GID="${OPENK_RUN_GID:-$(id -g)}"
BIND="${OPENK_BIND_ADDRESS:-127.0.0.1}"
PORT="${OPENK_PUBLISHED_PORT:-8000}"
TLS="${OPENK_TLS_CONTAINER:-}"
BACKUP=""

for directory in "$DATA" "$MEDIA" "$LIB"; do
  if [ ! -d "$directory" ]; then
    echo "目录不存在：$directory；请先创建并设置容器用户的读写权限。" >&2
    exit 1
  fi
done
docker image inspect "$IMAGE" >/dev/null
docker network inspect "$NET" >/dev/null
if [ -n "$TLS" ]; then docker exec "$TLS" nginx -t; fi

# 只读取所需变量；使用 docker -e NAME，避免把口令值放到进程参数中。
if docker inspect "$NAME" >/dev/null 2>&1; then
  existing_env="$(docker inspect "$NAME" --format '{{range .Config.Env}}{{println .}}{{end}}')"
  while IFS= read -r entry; do
    case "$entry" in
      OPENK_WORKER_TOKEN=*|OPENK_REMOTE_STEPS=*|OPENK_ALLOWED_ORIGINS=*|FORWARDED_ALLOW_IPS=*) export "$entry" ;;
    esac
  done <<< "$existing_env"
  BACKUP="${NAME}-rollback-$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi
: "${OPENK_WORKER_TOKEN:?请先配置随机 worker 口令；不要把口令提交到仓库}"
export OPENK_WORKER_TOKEN
export OPENK_REMOTE_STEPS="${OPENK_REMOTE_STEPS-separate,transcribe,align}"
export OPENK_ALLOWED_ORIGINS="${OPENK_ALLOWED_ORIGINS:-}"

EXTRA=()
if [ -n "${OPENK_MEDIA_GID:-}" ]; then EXTRA+=(--group-add "$OPENK_MEDIA_GID"); fi
if [ -n "$BACKUP" ]; then
  docker stop --time 30 "$NAME" >/dev/null
  docker rename "$NAME" "$BACKUP"
  docker update --restart=no "$BACKUP" >/dev/null
  echo "已保留旧容器：$BACKUP（不会自动重启；同时保留旧 worker 代码以便回退）"
fi

docker run -d --name "$NAME" --restart unless-stopped \
  --network "$NET" --user "$RUN_UID:$RUN_GID" \
  -p "$BIND:$PORT:8000" \
  -v "$DATA":/data -v "$MEDIA":/media/ktv:ro -v "$LIB":/library \
  -e HOME=/data \
  -e OPENK_LOCAL_MEDIA_DIRS=/media/ktv:/library \
  -e OPENK_LIBRARY_DIR=/library \
  -e OPENK_WORKER_TOKEN -e OPENK_REMOTE_STEPS \
  -e OPENK_ALLOWED_ORIGINS -e FORWARDED_ALLOW_IPS \
  "${EXTRA[@]}" "$IMAGE" >/dev/null

healthy=false
for _ in $(seq 1 45); do
  status="$(docker inspect "$NAME" --format '{{.State.Health.Status}}')"
  if [ "$status" = healthy ]; then healthy=true; break; fi
  if [ "$status" = unhealthy ]; then break; fi
  sleep 2
done
if [ "$healthy" != true ]; then
  echo "新容器未通过健康检查。请检查日志；旧容器 $BACKUP 仍保留，未删除任何数据。" >&2
  exit 1
fi

docker exec "$NAME" sh -c 'test -r /media/ktv && test -w /data && test -w /library'
if [ -n "$TLS" ]; then docker exec "$TLS" nginx -s reload; fi
echo "容器：$(docker ps --filter "name=^${NAME}$" --format '{{.Status}}')"
echo "服务地址：http://$BIND:$PORT（跨设备访问需显式配置可信网络地址或认证反向代理）"
